# Cliente público de Supabase. Estos valores pueden aparecer en el navegador;
# la seguridad real se aplica en PostgreSQL mediante RLS y Edge Functions.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICA_O_ANON

# / para desarrollo, dominio propio y Cloudflare Pages.
# GitHub Actions lo rellena automáticamente como /NOMBRE-DEL-REPOSITORIO/.
VITE_BASE_PATH=/
